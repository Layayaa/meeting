/**app.wxss — global design tokens**/

/* Reset */
page {
  background: #f5f6fa;
  min-height: 100vh;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1a1a2e;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: initial;
  border-radius: 0;
  padding: 0;
  margin: 0;
  line-height: normal;
}

button:focus { outline: 0; }
button::after { border: none; }

.tab,
.tag,
.status,
.status-badge,
.hero-badge,
.dispatch-status,
.pin-badge,
.rank-badge,
.admin-badge,
.empty-icon,
.input-icon,
.meta-icon,
.metric-icon,
.quick-icon,
.menu-code,
.room-status-tag,
.slot-tag,
.slot-check,
.voucher-status {
  display: flex;
  align-items: center;
  justify-content: center;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── Shared utility classes ── */

/* Cards */
.card {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 16rpx rgba(26,26,46,0.06);
}

/* Primary button */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.32);
}

/* Section label */
.sec-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9ca3af;
  letter-spacing: 1px;
  padding: 24rpx 28rpx 10rpx;
  text-transform: uppercase;
}

/* Module header */
.module-hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 34rpx 28rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: linear-gradient(145deg, #0b1f4d 0%, #123c7c 66%, #0f766e 120%);
  color: #fff;
}

.module-hero::after {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -120rpx;
  width: 260rpx;
  height: 260rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.22);
  border-radius: 50%;
}

.module-kicker {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 22rpx;
  color: rgba(219, 234, 254, 0.76);
}

.module-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  line-height: 1.12;
  font-weight: 800;
  color: #fff;
}

.module-desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(219, 234, 254, 0.78);
}
