/**app.wxss — global design tokens**/

/* Reset */
page {
  background: #f5f6fa;
  min-height: 100vh;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1a1a2e;
}

button {
  background: initial;
  border-radius: 0;
  padding: 0;
  margin: 0;
  line-height: normal;
}

button:focus { outline: 0; }
button::after { border: none; }

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ── Shared utility classes ── */

/* Cards */
.card {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 16rpx rgba(26,26,46,0.06);
}

/* Primary button */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.32);
}

/* Section label */
.sec-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9ca3af;
  letter-spacing: 1px;
  padding: 24rpx 28rpx 10rpx;
  text-transform: uppercase;
}
