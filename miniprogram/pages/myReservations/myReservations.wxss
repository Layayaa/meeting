/* pages/myReservations/myReservations.wxss */
page {
  background: #f4f7fb;
  min-height: 100vh;
}

.page {
  padding: 0 0 60rpx;
}

/* Empty / Auth state */
.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 60rpx;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.empty-mark.danger {
  background: linear-gradient(135deg, #7f1d1d, #dc2626);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.6;
}

.login-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 60rpx;
  height: 84rpx;
  border: none;
}

/* Profile Header */
.profile-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #e6edf7;
  padding: 36rpx 28rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.profile-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

.logout-btn {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid #fecaca;
  background: #fff5f5;
  color: #b91c1c;
  font-size: 24rpx;
  margin: 0;
}

/* Quota Row */
.quota-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-top: 1rpx solid #e6edf7;
  border-bottom: 1rpx solid #e6edf7;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.quota-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.quota-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #123c7c;
}

.quota-key {
  font-size: 22rpx;
  color: #9ca3af;
}

.quota-divider {
  width: 1rpx;
  height: 44rpx;
  background: #f3f4f6;
}

/* Section Label */
.section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #667085;
  padding: 0 28rpx 12rpx;
  letter-spacing: 1px;
}

/* Reserve Cards */
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.list-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #eff6ff;
  color: #123c7c;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.list-empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.reserve-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin: 0 24rpx 14rpx;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-room {
  font-size: 30rpx;
  font-weight: 700;
  color: #0b1f4d;
}

.status-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-pending { background: #eff6ff; color: #2563eb; }
.status-completed { background: #f0fdf4; color: #059669; }
.status-cancelled { background: #f3f4f6; color: #9ca3af; }

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #6b7280;
}

.meta-sep {
  font-size: 22rpx;
  color: #d1d5db;
}

.card-purpose {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f3f4f6;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
}

.cancel-btn {
  background: #fef2f2;
  color: #ef4444;
  border-radius: 8rpx;
  font-size: 24rpx;
  height: 60rpx;
  padding: 0 24rpx;
  border: none;
}

.cancel-expired {
  font-size: 24rpx;
  color: #d1d5db;
}

/* Menu Group */
.menu-group {
  background: #fff;
  border-radius: 12rpx;
  margin: 0 24rpx;
  overflow: hidden;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.menu-row.divider {
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-row:active {
  background: #f8fbff;
}

.menu-text {
  font-size: 28rpx;
  color: #0b1f4d;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}

.password-panel {
  margin: 16rpx 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.password-input {
  height: 76rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  font-size: 26rpx;
  color: #111827;
}

.password-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 8rpx 0 0;
  border-radius: 10rpx;
  background: #2563eb;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}

.password-submit::after {
  border: none;
}

/* Admin badge */
.admin-avatar {
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.admin-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #2563eb;
  background: #eff6ff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.admin-dashboard {
  margin: 0 24rpx 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.dashboard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.dashboard-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0b1f4d;
}

.dashboard-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.dashboard-link {
  font-size: 24rpx;
  color: #123c7c;
}

.dashboard-main {
  display: flex;
  align-items: stretch;
}

.dashboard-total {
  width: 210rpx;
  padding: 22rpx 20rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
}

.dashboard-total-num {
  display: block;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 800;
  color: #fff;
}

.dashboard-total-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.78);
}

.dashboard-side {
  flex: 1;
  margin-left: 18rpx;
}

.dashboard-mini {
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #f4f8ff;
  border: 1rpx solid #e6edf7;
}

.dashboard-mini + .dashboard-mini {
  margin-top: 14rpx;
}

.dashboard-mini-val {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #16233a;
}

.dashboard-mini-key {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

/* Menu row with icon */
.menu-row-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-wrap.blue   { background: #eff6ff; }
.menu-icon-wrap.cyan { background: #ecfeff; }
.menu-icon-wrap.green  { background: #f0fdf4; }
.menu-icon-wrap.yellow { background: #fffbeb; }
.menu-icon-wrap.red    { background: #fef2f2; }
.menu-icon-wrap.gold { background: #fff7e6; }

.menu-code {
  font-size: 22rpx;
  font-weight: 800;
  color: #123c7c;
}
