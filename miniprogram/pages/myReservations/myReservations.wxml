<!-- pages/myReservations/myReservations.wxml -->
<view class="page">

  <!-- 未登录 -->
  <view wx:if="{{!isBound}}" class="empty-page">
    <text class="empty-emoji">🔒</text>
    <text class="empty-title">请先登录</text>
    <text class="empty-desc">登录后可查看预约记录和个人信息</text>
    <button class="login-btn" bindtap="goLogin">去登录 / 注册</button>
  </view>

  <!-- 已禁用 -->
  <view wx:elif="{{userStatus === 'disabled'}}" class="empty-page">
    <text class="empty-emoji">🚫</text>
    <text class="empty-title">账户已被禁用</text>
    <text class="empty-desc">请联系管理员处理后再使用</text>
  </view>

  <!-- 管理员视图 -->
  <view wx:elif="{{isAdmin}}">

    <!-- 管理员 Profile -->
    <view class="profile-header">
      <view class="avatar admin-avatar">{{avatarChar}}</view>
      <view class="profile-info">
        <view class="profile-name-row">
          <text class="profile-name">{{userInfo.name || '管理员'}}</text>
          <view class="admin-badge">管理员</view>
        </view>
        <text class="profile-meta">{{userInfo.department ? userInfo.department + ' · ' : ''}}{{userInfo.maskedPhone || userInfo.phone}}</text>
      </view>
      <button class="logout-btn" bindtap="logout">退出</button>
    </view>

    <!-- 管理功能 -->
    <view class="section-label">管理功能</view>
    <view class="menu-group">
      <view class="menu-row divider" bindtap="goUserManage">
        <view class="menu-row-left">
          <view class="menu-icon-wrap blue"><text class="menu-emoji">👥</text></view>
          <text class="menu-text">用户管理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row divider" bindtap="goReservationManage">
        <view class="menu-row-left">
          <view class="menu-icon-wrap purple"><text class="menu-emoji">📋</text></view>
          <text class="menu-text">预约管理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row divider" bindtap="goFeedbackManage">
        <view class="menu-row-left">
          <view class="menu-icon-wrap yellow"><text class="menu-emoji">💬</text></view>
          <text class="menu-text">反馈管理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row divider" bindtap="goNoticeManage">
        <view class="menu-row-left">
          <view class="menu-icon-wrap red"><text class="menu-emoji">📢</text></view>
          <text class="menu-text">通知管理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row divider" bindtap="goActivityManage">
        <view class="menu-row-left">
          <view class="menu-icon-wrap green"><text class="menu-emoji">🎉</text></view>
          <text class="menu-text">活动管理</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goSettings">
        <view class="menu-row-left">
          <view class="menu-icon-wrap orange"><text class="menu-emoji">🔧</text></view>
          <text class="menu-text">次数规则设置</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

  </view>

  <!-- 普通用户视图 -->
  <view wx:else>

    <!-- 用户信息 -->
    <view class="profile-header">
      <view class="avatar">{{avatarChar}}</view>
      <view class="profile-info">
        <text class="profile-name">{{userInfo.name || '用户'}}</text>
        <text class="profile-meta">{{userInfo.department ? userInfo.department + ' · ' : ''}}{{userInfo.maskedPhone || userInfo.phone}}</text>
      </view>
      <button class="logout-btn" bindtap="logout">退出</button>
    </view>

    <!-- 本周额度 -->
    <view class="quota-row">
      <view class="quota-cell">
        <text class="quota-val">{{remainingCount}}</text>
        <text class="quota-key">本周剩余</text>
      </view>
      <view class="quota-divider"></view>
      <view class="quota-cell">
        <text class="quota-val">{{userInfo.extra_count || 0}}</text>
        <text class="quota-key">额外派发</text>
      </view>
      <view class="quota-divider"></view>
      <view class="quota-cell">
        <text class="quota-val">{{userInfo.used_count || 0}}</text>
        <text class="quota-key">已使用</text>
      </view>
    </view>

    <!-- 我的预约 -->
    <view class="section-label">我的预约</view>

    <view wx:if="{{!reservations.length}}" class="list-empty">
      <text class="list-empty-icon">📅</text>
      <text class="list-empty-text">暂无预约记录</text>
    </view>

    <view wx:for="{{reservations}}" wx:key="_id" class="reserve-card">
      <view class="card-top">
        <text class="card-room">{{item.room}}</text>
        <view class="status-badge status-{{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="card-meta">
        <text class="meta-text">{{item.date}}</text>
        <text class="meta-sep">·</text>
        <text class="meta-text">{{item.time_slot}}</text>
      </view>
      <text wx:if="{{item.purpose}}" class="card-purpose">{{item.purpose}}</text>
      <view wx:if="{{item.status === 'pending'}}" class="card-footer">
        <button wx:if="{{item.canCancel}}" class="cancel-btn" data-id="{{item._id}}" bindtap="cancelReservation">取消预约</button>
        <text wx:else class="cancel-expired">已过取消时限</text>
      </view>
    </view>

    <!-- 其他功能 -->
    <view class="section-label">其他</view>
    <view class="menu-group">
      <view class="menu-row divider" bindtap="goFeedbackSubmit">
        <text class="menu-text">意见反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goMyFeedbacks">
        <text class="menu-text">我的反馈</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

  </view>
</view>
