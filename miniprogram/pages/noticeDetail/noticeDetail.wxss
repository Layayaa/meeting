page { background: #f3f4f6; }
.page { padding: 20rpx; }
.empty { text-align: center; color: #9ca3af; padding: 60rpx 0; }
.card { background: #fff; border-radius: 14rpx; padding: 24rpx; }
.title { display: block; font-size: 34rpx; font-weight: 700; color: #111827; }
.time { display: block; margin-top: 10rpx; font-size: 22rpx; color: #9ca3af; }
.content { display: block; margin-top: 20rpx; font-size: 28rpx; color: #374151; line-height: 1.7; white-space: pre-wrap; }
