/* pages/reserve/reserve.wxss */
page {
  background: #f4f7fb;
  min-height: 100vh;
}

.page {
  padding: 0 0 120rpx;
}

/* Dispatch Hero */
.dispatch-hero {
  position: relative;
  overflow: hidden;
  padding: 54rpx 28rpx 28rpx;
  background: linear-gradient(145deg, #0b1f4d 0%, #123c7c 58%, #0f766e 120%);
  color: #fff;
}

.dispatch-hero::before {
  content: '';
  position: absolute;
  right: -130rpx;
  top: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.25);
  border-radius: 50%;
}

.dispatch-hero::after {
  content: '';
  position: absolute;
  left: 28rpx;
  bottom: 20rpx;
  width: 430rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(103, 232, 249, 0.7), rgba(255, 255, 255, 0));
}

.dispatch-head,
.dispatch-panel,
.dispatch-steps {
  position: relative;
  z-index: 1;
}

.dispatch-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.dispatch-kicker {
  display: block;
  font-size: 22rpx;
  color: rgba(219, 234, 254, 0.76);
}

.dispatch-title {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 800;
  color: #fff;
}

.dispatch-status {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 9rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(45, 212, 191, 0.45);
  color: #d1fae5;
  background: rgba(20, 184, 166, 0.18);
  font-size: 22rpx;
}

.dispatch-status.blocked {
  color: #fef3c7;
  border-color: rgba(214, 162, 58, 0.48);
  background: rgba(214, 162, 58, 0.15);
}

.dispatch-panel {
  display: flex;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.1);
}

.dispatch-quota {
  width: 190rpx;
  flex-shrink: 0;
  padding: 18rpx 16rpx;
  border-radius: 12rpx;
  background: linear-gradient(145deg, rgba(37, 99, 235, 0.58), rgba(20, 184, 166, 0.3));
}

.dispatch-num {
  display: block;
  font-size: 58rpx;
  line-height: 1;
  font-weight: 800;
  color: #fff;
}

.dispatch-num.zero {
  color: #fecaca;
}

.dispatch-label {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: rgba(219, 234, 254, 0.78);
}

.dispatch-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.dispatch-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 42rpx;
}

.dispatch-info-row + .dispatch-info-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-key {
  font-size: 21rpx;
  color: rgba(219, 234, 254, 0.68);
}

.info-val {
  max-width: 240rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dispatch-steps {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.step-item {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(219, 234, 254, 0.28);
  color: #dbeafe;
  font-size: 20rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.1);
}

.step-text {
  margin-left: 8rpx;
  font-size: 21rpx;
  color: rgba(219, 234, 254, 0.76);
}

.step-item.done .step-index {
  color: #0b1f4d;
  background: #67e8f9;
  border-color: #67e8f9;
}

.step-item.done .step-text {
  color: #fff;
  font-weight: 700;
}

.step-line {
  flex: 1;
  height: 1rpx;
  margin: 0 12rpx;
  background: rgba(219, 234, 254, 0.2);
}

.step-line.done {
  background: rgba(103, 232, 249, 0.78);
}

.dispatch-alert {
  margin: 18rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 10rpx;
  border: 1rpx solid #fde68a;
  background: #fffbeb;
  color: #92400e;
  font-size: 24rpx;
}

/* Card */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin: 24rpx 24rpx 0;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.card-title {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.title-dot {
  width: 6rpx;
  height: 40rpx;
  margin-top: 4rpx;
  background: #123c7c;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.title-main {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0b1f4d;
}

.title-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #8a95a8;
}

.optional {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 400;
}

/* Weekly Availability */
.weekly-card {
  padding-bottom: 24rpx;
}

.weekly-title-row {
  justify-content: space-between;
}

.weekly-title-row > view {
  display: flex;
  align-items: center;
}

.weekly-title-row .title-main,
.weekly-title-row .title-sub {
  margin-left: 24rpx;
}

.weekly-loading {
  font-size: 22rpx;
  color: #8a95a8;
  font-weight: 400;
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  margin: 2rpx 0 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  min-width: 132rpx;
  margin-right: 18rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #667085;
}

.legend-swatch {
  width: 32rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.legend-swatch.free {
  background: #dcfce7;
  border: 2rpx solid #86efac;
}

.legend-swatch.partial {
  background: #eff6ff;
  border: 2rpx solid #93c5fd;
}

.legend-swatch.full {
  background: #e5e7eb;
  border: 2rpx solid #cbd5e1;
}

.legend-swatch.expired {
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
}

.availability-scroll {
  white-space: nowrap;
}

.availability-table {
  display: inline-block;
  min-width: 940rpx;
  padding-bottom: 2rpx;
}

.availability-row {
  display: flex;
  align-items: center;
}

.availability-header {
  margin-bottom: 8rpx;
}

.time-head,
.time-cell {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #667085;
}

.time-cell {
  display: flex;
  align-items: center;
  height: 56rpx;
}

.date-head {
  width: 108rpx;
  flex-shrink: 0;
  text-align: center;
}

.date-head-main,
.date-head-sub {
  display: block;
}

.date-head-main {
  font-size: 23rpx;
  font-weight: 700;
  color: #16233a;
}

.date-head-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.availability-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 48rpx;
  margin: 4rpx 6rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
}

.availability-cell.free {
  color: #047857;
  background: #dcfce7;
}

.availability-cell.partial {
  color: #123c7c;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.availability-cell.full {
  color: #6b7280;
  background: #e5e7eb;
}

.availability-cell.expired {
  color: #cbd5e1;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
}

/* Date Scroll */
.date-scroll {
  white-space: nowrap;
}

.date-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 110rpx;
  border-radius: 10rpx;
  background: #f7faff;
  margin-right: 16rpx;
  border: 1rpx solid #e6edf7;
  transition: all 0.2s;
}

.date-chip.active {
  background: #eff6ff;
  border-color: #2563eb;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.12);
}

.date-chip-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #16233a;
}

.date-chip.active .date-chip-main {
  color: #123c7c;
}

.date-chip-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.date-chip.active .date-chip-sub {
  color: #2563eb;
}

/* Room */
.room-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.room-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 22rpx 8rpx;
  border-radius: 10rpx;
  background: #f7faff;
  border: 1rpx solid #e6edf7;
  transition: all 0.2s;
}

.room-chip.active {
  background: #eff6ff;
  border-color: #2563eb;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.12);
}

.room-radio {
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
  border: 3rpx solid #cbd5e1;
  box-sizing: border-box;
}

.room-radio.checked {
  border-color: #2563eb;
  background: #2563eb;
  box-shadow: inset 0 0 0 4rpx #eff6ff;
}

.room-chip-text {
  min-width: 0;
  font-size: 24rpx;
  color: #16233a;
  font-weight: 500;
}

.room-chip.active .room-chip-text {
  color: #123c7c;
  font-weight: 600;
}

.room-detail-card {
  display: flex;
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.room-detail-image {
  width: 220rpx;
  height: 170rpx;
  flex-shrink: 0;
  background: #e6edf7;
}

.room-detail-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
}

.room-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.room-detail-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0b1f4d;
}

.room-capacity {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #123c7c;
  background: #eff6ff;
}

.room-equipment {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* Time Slots */
.slot-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.slot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid transparent;
  transition: all 0.15s;
}

.slot-item.timeslot-item {
  background: #f7faff;
  border-color: #e6edf7;
}

.slot-item.timeslot-item.selected {
  background: #eff6ff;
  border-color: #2563eb;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.12);
}

.slot-item.timeslot-item.reserved,
.slot-item.timeslot-item.full {
  background: #f9fafb;
  opacity: 0.6;
}

.slot-item.timeslot-item.expired {
  background: #f3f4f6;
  opacity: 0.45;
}

.slot-time {
  font-size: 26rpx;
  color: #16233a;
  font-weight: 500;
}

.timeslot-item.selected .slot-time {
  color: #123c7c;
  font-weight: 600;
}

.timeslot-item.expired .slot-time,
.timeslot-item.reserved .slot-time,
.timeslot-item.full .slot-time {
  color: #9ca3af;
}

.slot-status {
  display: flex;
  align-items: center;
}

.slot-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.slot-tag.free {
  color: #047857;
  background: #ecfdf5;
}

.slot-tag.busy, .slot-tag.reserved {
  color: #9ca3af;
  background: #f3f4f6;
}

.slot-tag.expired {
  color: #d1d5db;
  background: #f3f4f6;
}

.slot-check {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #123c7c;
  background: #dbeafe;
  font-weight: 700;
}

/* Purpose */
.purpose-input {
  width: 100%;
  min-height: 140rpx;
  background: #f7faff;
  border: 1rpx solid #e6edf7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #16233a;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* Confirm Button */
.btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx 40rpx;
  border-top: 1rpx solid #e6edf7;
  box-shadow: 0 -8rpx 24rpx rgba(15, 42, 95, 0.08);
}

.block-tip {
  text-align: center;
  font-size: 24rpx;
  color: #92400e;
  margin-bottom: 12rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.28);
}

.confirm-btn[disabled] {
  background: #e5e7eb;
  color: #9ca3af;
  box-shadow: none;
}

/* Reservation Voucher */
.voucher-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx 24rpx 48rpx;
  background: rgba(11, 31, 77, 0.58);
  box-sizing: border-box;
}

.voucher-card {
  width: 100%;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 18rpx 48rpx rgba(11, 31, 77, 0.26);
}

.voucher-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 30rpx 30rpx 26rpx;
  background: linear-gradient(145deg, #0b1f4d, #123c7c);
}

.voucher-kicker {
  display: block;
  font-size: 22rpx;
  color: rgba(219, 234, 254, 0.74);
}

.voucher-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
}

.voucher-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(45, 212, 191, 0.45);
  color: #d1fae5;
  background: rgba(20, 184, 166, 0.18);
  font-size: 22rpx;
}

.voucher-no-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 30rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 10rpx;
  background: #f4f8ff;
  border: 1rpx solid #dbeafe;
}

.voucher-no-label {
  font-size: 23rpx;
  color: #6b7280;
}

.voucher-no {
  max-width: 400rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #0b1f4d;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.voucher-lines {
  margin: 22rpx 30rpx 0;
  border-top: 1rpx solid #e6edf7;
}

.voucher-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e6edf7;
}

.voucher-key {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6b7280;
}

.voucher-value {
  max-width: 440rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 700;
  color: #16233a;
  line-height: 1.4;
}

.voucher-note {
  margin: 22rpx 30rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 23rpx;
  line-height: 1.5;
}

.voucher-actions {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 30rpx 0;
}

.voucher-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 78rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.voucher-btn::after {
  border: none;
}

.voucher-btn.secondary {
  color: #123c7c;
  background: #eff6ff;
}

.voucher-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
}

.voucher-close {
  padding: 22rpx 30rpx 30rpx;
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
}
