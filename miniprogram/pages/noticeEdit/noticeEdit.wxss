page { background: #f3f4f6; }
.page { padding: 20rpx; }
.empty { text-align: center; color: #9ca3af; padding: 60rpx 0; }
.card { background: #fff; border-radius: 14rpx; padding: 20rpx; }
.group { margin-bottom: 16rpx; }
.group.row { display: flex; align-items: center; justify-content: space-between; }
.label { display: block; font-size: 26rpx; color: #111827; font-weight: 600; margin-bottom: 8rpx; }
.input { height: 74rpx; background: #f9fafb; border: 2rpx solid #e5e7eb; border-radius: 10rpx; padding: 0 14rpx; font-size: 26rpx; }
.textarea { width: 100%; height: 240rpx; background: #f9fafb; border: 2rpx solid #e5e7eb; border-radius: 10rpx; padding: 14rpx; box-sizing: border-box; font-size: 26rpx; }
.status-row { display: flex; gap: 10rpx; }
.status { flex: 1; text-align: center; height: 64rpx; line-height: 64rpx; border-radius: 10rpx; background: #e5e7eb; color: #4b5563; }
.status.active { background: #2563eb; color: #fff; }
.btn-row { display: flex; gap: 10rpx; margin-top: 20rpx; }
.draft { flex: 1; background: #e5e7eb; color: #374151; border-radius: 10rpx; border: none; }
.publish { flex: 1; background: #2563eb; color: #fff; border-radius: 10rpx; border: none; }
