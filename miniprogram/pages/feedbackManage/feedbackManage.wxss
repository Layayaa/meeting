page {
  background: #f4f7fb;
}

.page {
  padding: 0 24rpx 60rpx;
}

.tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 64rpx;
  border-radius: 10rpx;
  background: #e6edf7;
  color: #4b5563;
  font-size: 24rpx;
}

.tab.active {
  background: #123c7c;
  color: #fff;
  font-weight: 700;
}

.empty {
  padding: 60rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
}

.card {
  margin-bottom: 14rpx;
  padding: 22rpx;
  border: 1rpx solid #e6edf7;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  color: #0b1f4d;
  font-size: 26rpx;
  font-weight: 700;
}

.status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status.pending {
  background: #fff7ed;
  color: #c2410c;
}

.status.replied {
  background: #ecfdf5;
  color: #059669;
}

.content {
  display: block;
  margin-top: 10rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.5;
}

.time {
  display: block;
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
}
