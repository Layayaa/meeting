page { background: #f3f4f6; }
.page { padding: 20rpx; }
.tabs { display: flex; gap: 10rpx; margin-bottom: 14rpx; }
.tab { flex: 1; text-align: center; height: 64rpx; line-height: 64rpx; border-radius: 10rpx; background: #e5e7eb; color: #4b5563; }
.tab.active { background: #2563eb; color: #fff; }
.empty { text-align: center; color: #9ca3af; padding: 60rpx 0; }
.card { background: #fff; border-radius: 14rpx; padding: 18rpx; margin-bottom: 12rpx; }
.top { display: flex; align-items: center; justify-content: space-between; }
.name { font-size: 26rpx; color: #111827; font-weight: 600; }
.status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 12rpx; }
.status.pending { background: #fff7ed; color: #c2410c; }
.status.replied { background: #ecfdf5; color: #059669; }
.content { display: block; margin-top: 8rpx; font-size: 25rpx; color: #4b5563; }
.time { display: block; margin-top: 8rpx; font-size: 22rpx; color: #9ca3af; }
