/* pages/index/index.wxss */
page {
  background: #f0f2f7;
  min-height: 100vh;
}

.page {
  padding: 0 0 60rpx;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 56rpx 32rpx 28rpx;
  background: #fff;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.header-greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.header-sub {
  font-size: 24rpx;
  color: #9ca3af;
}

.admin-tag {
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* Banner */
.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
}

.banner-warn {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.banner-danger {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}

.banner-text {
  font-size: 26rpx;
  color: #374151;
}

.banner-arrow {
  font-size: 30rpx;
  color: #9ca3af;
}

/* Quota Card */
.quota-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #2563eb, #1e40af);
  border-radius: 20rpx;
}

.quota-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.quota-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.quota-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.quota-right {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.quota-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.quota-num.zero {
  color: #fca5a5;
}

.quota-unit {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

/* Section */
.section {
  margin: 24rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.section-sub {
  font-size: 22rpx;
  color: #9ca3af;
}

.section-link {
  font-size: 24rpx;
  color: #2563eb;
}

/* Room List */
.room-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.room-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}

.room-item.divider {
  border-bottom: 1rpx solid #f3f4f6;
}

.room-item:active {
  background: #f9fafb;
}

.room-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.room-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.room-dot.free { background: #10b981; }
.room-dot.busy { background: #f59e0b; }

.room-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.room-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tag-free {
  font-size: 22rpx;
  color: #059669;
  background: #ecfdf5;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.tag-busy {
  font-size: 22rpx;
  color: #92400e;
  background: #fffbeb;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.chevron {
  font-size: 32rpx;
  color: #d1d5db;
}

/* Notice Card */
.notice-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.notice-card:active {
  background: #f9fafb;
}

.notice-loading {
  font-size: 24rpx;
  color: #9ca3af;
}

.notice-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.pin-tag {
  font-size: 20rpx;
  color: #dc2626;
  background: #fee2e2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.notice-body {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.notice-time {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}

/* Admin Entry */
.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.admin-entry:active {
  background: #f9fafb;
}

.admin-entry-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.admin-entry-icon {
  font-size: 32rpx;
}

.admin-entry-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
