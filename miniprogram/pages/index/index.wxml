<!-- pages/index/index.wxml -->
<view class="page">

  <!-- Header: 用户信息 -->
  <view class="header">
    <view class="header-left">
      <text class="header-greeting">你好，{{displayName || '访客'}}</text>
      <text class="header-sub" wx:if="{{userInfo.department}}">{{userInfo.department}}</text>
      <text class="header-sub" wx:elif="{{!isBound}}">登录后可使用预约功能</text>
    </view>
    <view wx:if="{{isAdmin}}" class="admin-tag">管理员</view>
  </view>

  <!-- 状态提示（仅异常时显示） -->
  <view wx:if="{{!isBound}}" class="banner banner-warn" bindtap="goLogin">
    <text class="banner-text">⚠️ 未登录，点击前往登录</text>
    <text class="banner-arrow">›</text>
  </view>
  <view wx:elif="{{userStatus === 'disabled'}}" class="banner banner-danger">
    <text class="banner-text">🚫 账户已禁用，请联系管理员</text>
  </view>

  <!-- 本周预约额度（已登录才显示） -->
  <view wx:if="{{isBound && userStatus === 'active'}}" class="quota-card" bindtap="goReserve">
    <view class="quota-left">
      <text class="quota-title">本周可用次数</text>
      <text class="quota-hint">点击立即预约</text>
    </view>
    <view class="quota-right">
      <text class="quota-num {{remainingCount <= 0 ? 'zero' : ''}}">{{remainingCount}}</text>
      <text class="quota-unit">次</text>
    </view>
  </view>

  <!-- 今日会议室状态 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">今日会议室</text>
      <text class="section-sub">{{todayDisplay}}</text>
    </view>
    <view class="room-list">
      <view
        wx:for="{{todayRooms}}"
        wx:key="room"
        class="room-item {{index < todayRooms.length - 1 ? 'divider' : ''}}"
        data-room="{{item.room}}"
        bindtap="goReserveWithRoom"
      >
        <view class="room-left">
          <view class="room-dot {{item.isFree ? 'free' : 'busy'}}"></view>
          <text class="room-name">{{item.room}}</text>
        </view>
        <view class="room-right">
          <text class="{{item.isFree ? 'tag-free' : 'tag-busy'}}">{{item.isFree ? '空闲' : item.statusText}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 最新通知（有通知才显示） -->
  <view wx:if="{{noticePreview || noticePreviewLoading}}" class="section">
    <view class="section-header">
      <text class="section-title">最新通知</text>
      <text class="section-link" bindtap="goNotices">全部 ›</text>
    </view>
    <view class="notice-card" bindtap="openNoticePreview">
      <view wx:if="{{noticePreviewLoading}}" class="notice-loading">加载中...</view>
      <view wx:else>
        <view class="notice-title-row">
          <text wx:if="{{noticePreview.is_pinned}}" class="pin-tag">置顶</text>
          <text class="notice-title">{{noticePreview.title}}</text>
        </view>
        <text class="notice-body">{{noticePreview.contentPreview}}</text>
        <text class="notice-time">{{noticePreview.timeText}}</text>
      </view>
    </view>
  </view>

  <!-- 管理员入口（仅管理员显示） -->
  <view wx:if="{{isAdmin}}" class="section">
    <view class="admin-entry" bindtap="goAdmin">
      <view class="admin-entry-left">
        <text class="admin-entry-icon">⚙️</text>
        <text class="admin-entry-text">进入管理后台</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

</view>
