/* pages/notices/notices.wxss */
page {
  background: #f4f7fb;
  min-height: 100vh;
}

.page {
  padding: 20rpx 24rpx 60rpx;
}

/* States */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #eff6ff;
  color: #123c7c;
  font-size: 30rpx;
  font-weight: 800;
}

.state-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #e5e7eb;
  border-top-color: #2563eb;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Notice Card */
.notice-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.notice-card:active {
  background: #f8fbff;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.pin-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8a5a12;
  background: #fff7e6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0b1f4d;
  line-height: 1.5;
}

.chevron {
  font-size: 36rpx;
  color: #d1d5db;
  flex-shrink: 0;
  margin-top: -2rpx;
}

.notice-preview {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.notice-time {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}
