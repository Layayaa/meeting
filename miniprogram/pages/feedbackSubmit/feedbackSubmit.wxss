page {
  background: #f4f7fb;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e6edf7;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
}

.textarea {
  width: 100%;
  height: 220rpx;
  color: #16233a;
  font-size: 28rpx;
  line-height: 1.6;
}

.count {
  display: block;
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 22rpx;
  text-align: right;
}

.img-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  color: #0b1f4d;
  font-size: 26rpx;
  font-weight: 700;
}

.choose {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border: none;
  border-radius: 10rpx;
  background: #eff6ff;
  color: #123c7c;
  font-size: 24rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.img {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.del {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #ef4444;
  color: #fff;
  font-size: 24rpx;
}

.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 20rpx;
  border: none;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
