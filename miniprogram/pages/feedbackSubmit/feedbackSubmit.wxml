<view class="page">
  <view class="card">
    <textarea class="textarea" maxlength="500" value="{{content}}" bindinput="bindContent" placeholder="请描述您的问题或建议"></textarea>
    <text class="count">{{content.length}}/500</text>
  </view>

  <view class="card">
    <view class="img-head">
      <text>反馈图片（最多3张）</text>
      <button class="choose" bindtap="chooseImages">上传图片</button>
    </view>
    <view class="img-grid">
      <view wx:for="{{images}}" wx:key="*this" class="img-item">
        <image class="img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"></image>
        <view class="del" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
    </view>
  </view>

  <button class="submit" bindtap="submit" loading="{{submitting}}">提交反馈</button>
</view>
