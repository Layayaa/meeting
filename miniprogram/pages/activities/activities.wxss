/* pages/activities/activities.wxss */
page {
  background: #f4f7fb;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f4d;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

.retry-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  width: 240rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
  font-size: 26rpx;
  border: none;
}

/* Activity Card */
.activity-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e6edf7;
  box-shadow: 0 10rpx 28rpx rgba(15, 42, 95, 0.07);
  overflow: hidden;
}

.card-header {
  margin-bottom: 20rpx;
}

.card-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eff6ff;
  color: #123c7c;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
  letter-spacing: 1px;
}

.activity-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0b1f4d;
  line-height: 1.4;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.meta-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #123c7c;
  font-size: 18rpx;
  font-weight: 800;
}

.meta-text {
  font-size: 26rpx;
  color: #6b7280;
}

.desc-text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin: 16rpx 0;
  padding: 16rpx;
  background: #f7faff;
  border-radius: 10rpx;
}

/* QR Code */
.qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx;
  margin: 16rpx 0;
  background: #fafafa;
  border-radius: 14rpx;
  border: 1rpx dashed #e5e7eb;
}

.qr-image {
  width: 236rpx;
  height: 236rpx;
}

.qr-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 14rpx;
  text-align: center;
}

/* Card Actions */
.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #0b1f4d, #2563eb);
  color: #fff;
}

.action-btn.secondary {
  background: #f3f4f6;
  color: #374151;
}
